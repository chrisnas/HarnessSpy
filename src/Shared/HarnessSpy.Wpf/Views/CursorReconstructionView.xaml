<UserControl x:Class="HarnessSpy.Wpf.Views.CursorReconstructionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HarnessSpy.Wpf.Converters"
             xmlns:input="clr-namespace:HarnessSpy.Wpf.Input"
             xmlns:viewModels="clr-namespace:HarnessSpy.Wpf.ViewModels">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HarnessSpy.Wpf;component/Themes/InspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

            <DataTemplate x:Key="PipelineItemTemplate"
                          DataType="{x:Type viewModels:CursorReconstructionItemViewModel}">
                <Border Margin="1"
                        Padding="2"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRelationHighlighted}"
                                             Value="True">
                                    <Setter Property="Background" Value="#DAFBE1" />
                                    <Setter Property="BorderBrush" Value="#2DA44E" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Margin="6,0,0,0"
                                    Padding="5,0"
                                    Background="#DDF4FF"
                                    BorderBrush="#54AEFF"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="10"
                                           Foreground="#0969DA"
                                           Text="{Binding Badge}" />
                            </Border>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Header}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#57606A"
                                   Text="{Binding Summary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <HierarchicalDataTemplate DataType="{x:Type viewModels:CursorReconstructionItemViewModel}"
                                      ItemsSource="{Binding Children}">
                <Border Padding="2,1"
                        CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRelationHighlighted}"
                                             Value="True">
                                    <Setter Property="Background" Value="#DAFBE1" />
                                    <Setter Property="BorderBrush" Value="#2DA44E" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                    <Grid Width="16"
                          Height="16"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/CursorDBNavigator;component/Assets/Folder32.png"
                               Visibility="{Binding IsFolderLike, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Image Source="pack://application:,,,/CursorDBNavigator;component/Assets/Cursor.png"
                               Visibility="{Binding IsSession, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Header}" />
                    <Border Margin="7,0,0,0"
                            Padding="5,0"
                            Background="#DDF4FF"
                            BorderBrush="#54AEFF"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="10"
                                   Foreground="#0969DA"
                                   Text="{Binding Badge}" />
                    </Border>
                    <TextBlock MaxWidth="260"
                               Margin="7,0,0,0"
                               Foreground="#57606A"
                               Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </HierarchicalDataTemplate>

            <Style TargetType="{x:Type TreeViewItem}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                <Setter Property="Padding" Value="1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="245" MinHeight="180" />
            <RowDefinition Height="5" />
            <RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="10"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,8"
                           FontWeight="SemiBold"
                           Text="Reconstruction pipeline — select any stage to inspect its rule and source evidence" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="1. Workspace">
                        <ListBox ItemTemplate="{StaticResource PipelineItemTemplate}"
                                 ItemsSource="{Binding Reconstruction.WorkspaceStage}"
                                 SelectionChanged="Pipeline_SelectionChanged" />
                    </GroupBox>
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#57606A"
                               Text="→" />
                    <GroupBox Grid.Column="2" Header="2. Composer / session">
                        <ListBox ItemTemplate="{StaticResource PipelineItemTemplate}"
                                 ItemsSource="{Binding Reconstruction.ComposerStage}"
                                 SelectionChanged="Pipeline_SelectionChanged" />
                    </GroupBox>
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#57606A"
                               Text="→" />
                    <GroupBox Grid.Column="4" Header="3. Ordered bubbles">
                        <ListBox ItemTemplate="{StaticResource PipelineItemTemplate}"
                                 ItemsSource="{Binding Reconstruction.BubbleStage}"
                                 SelectionChanged="Pipeline_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </GroupBox>
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#57606A"
                               Text="→" />
                    <GroupBox Grid.Column="6" Header="4. Turns / thoughts / tools">
                        <ListBox ItemTemplate="{StaticResource PipelineItemTemplate}"
                                 ItemsSource="{Binding Reconstruction.OutputStage}"
                                 SelectionChanged="Pipeline_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </GroupBox>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="#EEF1F4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Reconstructed tree" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="#57606A"
                                   Text="Logical entities with their physical evidence retained." />
                    </StackPanel>
                    <TreeView Padding="4"
                              BorderThickness="0"
                              ItemsSource="{Binding Reconstruction.Roots}"
                              SelectedItemChanged="Tree_SelectionChanged"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#EEF1F4" />

            <Grid Grid.Column="2">
                <Border Padding="24"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding Reconstruction.HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#57606A"
                               Text="Select a reconstructed entity or pipeline stage." />
                </Border>

                <DockPanel Visibility="{Binding Reconstruction.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border DockPanel.Dock="Top"
                            Margin="0,0,0,10"
                            Padding="12,10"
                            Background="#F6F8FA"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding Reconstruction.SelectedTitle}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#57606A"
                                           Text="{Binding Reconstruction.SelectedSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="142"
                                    Margin="12,0,0,0"
                                    Padding="10,4"
                                    Click="GoToSourceBubble_Click"
                                    Content="Go to source bubble"
                                    IsEnabled="{Binding Reconstruction.CanGoToSourceBubble}" />
                            <Button Grid.Column="2"
                                    MinWidth="130"
                                    Margin="6,0,0,0"
                                    Padding="10,4"
                                    Click="OpenPhysicalSource_Click"
                                    Content="Go to physical row"
                                    IsEnabled="{Binding Reconstruction.CanOpenPhysicalSource}" />
                        </Grid>
                    </Border>

                    <TabControl>
                        <TabItem Header="Interpretation">
                            <ScrollViewer Margin="10"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                               Text="Applied reconstruction rule" />
                                    <Border Padding="10"
                                            Background="#F6F8FA"
                                            BorderBrush="#D0D7DE"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock FontFamily="Consolas"
                                                   Text="{Binding Reconstruction.SelectedRule}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Margin="0,14,0,6"
                                               Style="{StaticResource SectionHeaderStyle}"
                                               Text="Why this node exists" />
                                    <TextBlock Text="The logical node remains linked to the SQLite row or JSONL record that produced it. Ambiguous and missing joins remain visible in the Physical storage view."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Evidence">
                            <DataGrid x:Name="EvidenceDataGrid"
                                      Margin="8"
                                      ItemsSource="{Binding Reconstruction.EvidenceFields}"
                                      Style="{StaticResource InspectorGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field"
                                                        Binding="{Binding Name}"
                                                        Width="150" />
                                    <DataGridTemplateColumn Header="Value" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="4,2"
                                                           FontFamily="Consolas"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="JSON">
                            <Grid Margin="8">
                                <input:FindableTextBox Text="{Binding Reconstruction.JsonSource, Mode=OneWay}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Raw source">
                            <DockPanel Margin="8">
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="0,0,0,6"
                                           Foreground="#57606A"
                                           Text="{Binding Reconstruction.RawStatus}" />
                                <TextBox Style="{StaticResource RawValueTextBoxStyle}"
                                         Text="{Binding Reconstruction.RawSource, Mode=OneWay}" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
