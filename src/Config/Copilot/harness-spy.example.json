{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "& '<COPILOTSPY_HOOK_EXECUTABLE>' --event sessionStart --source copilot-cli --hook sessionStart --runtime github-copilot --dialect copilot-cli-camel",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "github-copilot"
        }
      }
    ],
    "sessionEnd": [
