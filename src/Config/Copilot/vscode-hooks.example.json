          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
        }
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "& '<COPILOTSPY_HOOK_EXECUTABLE>' --event SubagentStop --source vscode-local --hook SubagentStop --runtime github-copilot --dialect vscode-local",
        "cwd": ".",
        "timeout": 5,
        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
        }
      }
    ],
    "Stop": [
      {
