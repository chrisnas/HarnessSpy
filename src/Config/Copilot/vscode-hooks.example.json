{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "& '<COPILOTSPY_HOOK_EXECUTABLE>' --event SessionStart --source vscode-local --hook SessionStart --runtime github-copilot --dialect vscode-local",
        "cwd": ".",
        "timeout": 5,
        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
        }
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "& '<COPILOTSPY_HOOK_EXECUTABLE>' --event UserPromptSubmit --source vscode-local --hook UserPromptSubmit --runtime github-copilot --dialect vscode-local",
        "cwd": ".",
        "timeout": 5,
        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
        }
      }
    ],
    "PreToolUse": [
