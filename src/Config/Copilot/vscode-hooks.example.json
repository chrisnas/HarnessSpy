        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
        }
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "& '<COPILOTSPY_HOOK_EXECUTABLE>' --event PreCompact --source vscode-local --hook PreCompact --runtime github-copilot --dialect vscode-local",
        "cwd": ".",
        "timeout": 5,
        "env": {
          "HARNESS_SPY_HOST": "github-copilot",
          "HARNESS_SPY_RUNTIME_ID": "vscode-agent-hooks"
